{
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "p=\"${CLAUDE_PLUGIN_ROOT}/scripts/noti-toasti-windows.ps1\"; command -v wslpath >/dev/null 2>&1 && p=\"$(wslpath -w \"$p\")\"; powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$p\" -Distro \"${WSL_DISTRO_NAME:-}\""
          }
        ]
      }
    ]
  }
}
